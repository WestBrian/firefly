# Convex public URLs for the client and HTTP actions, followed by the deployment identifier.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Set these on the Convex deployment. Use the public frontend origin when hosted.
SITE_URL=http://localhost:3000
RESEND_KEY=
SENDER_EMAIL=
SENDER_NAME=

# Credentials for authenticating requests to the Alpaca API.
ALPACA_KEY=
ALPACA_SECRET=
